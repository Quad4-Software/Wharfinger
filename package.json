{
	"name": "wharfinger",
	"version": "0.1.0",
	"description": "Self-hosted ops platform: monitoring, status pages, deployments, and agents",
	"license": "QSL-1.0-0BSD",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:tsgo": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"vitals": "node scripts/vitals.mjs",
		"knip": "knip",
		"check:files": "node scripts/check-files.mjs",
		"check:i18n": "node scripts/check-i18n.mjs",
		"check:tests": "node scripts/check-tests.mjs",
		"check:coverage": "vitest run --coverage",
		"verify": "pnpm run check && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run knip && pnpm run check:files && pnpm run check:i18n && pnpm run check:tests && pnpm run build"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.41.0",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.1",
		"bits-ui": "2.19.0",
		"ldapts": "^9.0.0",
		"runed": "0.37.1",
		"smol-toml": "1.8.0",
		"undici": "8.10.2",
		"uqr": "0.1.3",
		"valibot": "1.4.2",
		"web-push": "^3.6.7",
		"ws": "^8.21.3",
		"yaml": "2.8.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.2",
		"@types/web-push": "^3.6.4",
		"@types/ws": "^8.18.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/devtools": "0.7.5",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"jsdom": "30.1.1",
		"knip": "6.38.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
